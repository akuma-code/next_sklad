generator client {
  provider = "prisma-client"
  output   = "../db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sklad {
  id         Int          @id @default(autoincrement())
  amount     Int          @default(1)
  title      String
  img        String?
  production Production[]

  info Info[]

  @@map("sklad")
}

model Production {
  id      Int     @id @default(autoincrement())
  endsAt  String
  isReady Boolean @default(false)

  skladId Int
  sklad   Sklad @relation(fields: [skladId], references: [id])

  @@map("production")
}

model Info {
  uuid  String  @id @unique @default(uuid())
  text  String  @default("")
  sklad Sklad[]

  @@map("info")
}
