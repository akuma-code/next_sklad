// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../db/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_LOCAL")
}

model Sklad {
  id         Int          @id @default(autoincrement())
  amount     Int          @default(1)
  production Production[]
  okno       Okno?        @relation(fields: [oknoId], references: [id], onDelete: Cascade)

  oknoId Int? @unique

  @@map("sklad")
}

model Okno {
  id    Int    @id @default(autoincrement())
  title String
  img   String @default("no_image")

  sklad Sklad?

  @@map("okna")
}

model Production {
  id      Int     @id @default(autoincrement())
  endsAt  String
  isReady Boolean @default(false)

  skladId Int
  sklad   Sklad @relation(fields: [skladId], references: [id])

  @@map("production")
}
